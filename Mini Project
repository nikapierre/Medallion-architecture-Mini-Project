ALTER TABLE SILVER_NP RENAME COLUMN STATE TO state;
ALTER TABLE SILVER_NP RENAME COLUMN SALES TO sales;
ALTER TABLE SILVER_NP RENAME COLUMN QUANTITY TO quantity;
ALTER TABLE SILVER_NP RENAME COLUMN PROFIT TO profit;

--ROUND SALES AND PROFIT to 2.dp
UPDATE SILVER_NP SET sales = ROUND(sales,2);
UPDATE SILVER_NP SET profit = ROUND(profit,2);


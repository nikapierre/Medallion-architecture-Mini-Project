--GOLD

-- Monthly State Sales
create table GOLD_MONTHLY_STATE_SALES_NP as(

WITH sales_profit AS(
select
"country/region"
,state
,order_year
,order_month
,ROUND(sum(profit)/sum(sales),2) as total_profit_margin
FROM SILVER1_NP
group by all
)

SELECT
S."country/region"
,S.state
,S.order_year
,S.order_month
,count(distinct order_id) as distinct_orders
,sum(quantity) as total_quantity
,sum(sales) as total_sales
,sum(profit) as total_profit
,ROUND(AVG(days_to_ship),0) as avg_days_to_ship
FROM SILVER1_NP S
INNER JOIN sales_profit SP
ON S."country/region"=SP."country/region"
AND S.state=SP.state
AND S.order_year=SP.order_year
AND S.order_month=SP.order_month
group by all
);

SELECT *
FROM GOLD_MONTHLY_STATE_SALES_NP;

--- Customer Summary
create table Customer_Summary_NP as(
WITH o_dates AS (
SELECT
customer_id
,MIN(order_date) as first_order_date
,MAX(order_date) as last_order_date
FROM SILVER1_NP
group by all
)
, order_val AS(
select
customer_id
,ROUND(sum(sales)/count(distinct order_id),2) as avg_order_value
FROM SILVER1_NP
group by all
)
SELECT
S.customer_id
,OD.first_order_date
,OD.last_order_date
,sum(S.quantity) as total_quantity
,sum(S.sales) as total_sales
,sum(S.profit) as total_profit
,OV.avg_order_value
,rank() over ( order by total_sales desc) as customer_rank
FROM SILVER1_NP S
INNER JOIN order_val OV
ON S.CUSTOMER_ID=OV.customer_ID
INNER JOIN o_dates OD
ON S.CUSTOMER_ID=OD.CUSTOMER_ID
group by all);

SELECT *
FROM Customer_Summary_NP;
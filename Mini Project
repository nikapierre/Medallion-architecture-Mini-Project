ALTER table SILVER_NP add column "Ship Date" DATE;
update SILVER_NP set "Ship Date" = "Ship Date String";

-- Rename all headers to snake case
ALTER TABLE SILVER_NP RENAME COLUMN "Order ID" TO order_id;
ALTER TABLE SILVER_NP RENAME COLUMN "Order Date" TO order_date;
ALTER TABLE SILVER_NP RENAME COLUMN "Ship Date" TO ship_date;
ALTER TABLE SILVER_NP RENAME COLUMN "Customer ID" TO customer_id;
ALTER TABLE SILVER_NP RENAME COLUMN "Country/Region" TO "country/region";

-- ADDD DAYS TO SHIP, ORDER YEAR, ORDER MONTH, PROFIT_MARGIN
create table SILVER1_NP as (

SELECT
order_id
,order_date
,YEAR(order_date) as order_year
,MONTHNAME(order_date) as order_month
,ship_date
,DATEDIFF('days',order_date,ship_date) as days_to_ship
,customer_id
,"country/region"
,city
,TRIM(state) as state
,sales
,quantity
,profit
,ROUND(profit/sales,2) as profit_margin
,loaded_at
FROM SILVER_NP
);
-- drop to recreate again
drop table SILVER1_NP;

-- Remove Duplicates
create table SILVER1_NP as (
SELECT
order_id
,order_date
,YEAR(order_date) as order_year
,MONTHNAME(order_date) as order_month
,ship_date
,DATEDIFF('days',order_date,ship_date) as days_to_ship
,customer_id
,"country/region"
,city
,TRIM(state) as state
,sales
,quantity
,profit
,ROUND(profit/sales,2) as profit_margin
,loaded_at
FROM SILVER_NP
qualify ROW_NUMBER() OVER (PARTITION BY order_id, order_date, order_year, order_month, ship_date, days_to_ship, customer_id, "country/region", city, state, sales, quantity, profit , profit_margin ORDER BY loaded_at) =1);

SELECT*
FROM SILVER1_NP;

